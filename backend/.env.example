# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ethar-alpha

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Admin Configuration
ADMIN_EMAIL=admin@ethar.com
ADMIN_PASSWORD=admin123

# WebSocket Configuration
WS_PORT=3001

# External API Configuration
# OpenSea API Key for NFT data
OPENSEA_API_KEY=your-opensea-api-key-here

# Stock API Configuration (Alpha Vantage)
STOCK_API_KEY=your-alpha-vantage-api-key-here
STOCK_API_BASE_URL=https://www.alphavantage.co/query

# CoinGecko API (no key required for basic usage)
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3